{
  "name": "MetaMask",
  "version": "7.24.0",
  "private": true,
  "description": "MetaMask Mobile - Ethereum Wallet",
  "scripts": {
    "start": "react-native start",
    "start:clean": "react-native start --reset-cache",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "test:unit": "jest --testPathPattern='.*\.test\.(ts|tsx|js)$'",
    "test:e2e:android": "wdio wdio.conf.js --platform android",
    "test:e2e:ios": "wdio wdio.conf.js --platform ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,json,md}'",
    "format:check": "prettier --check '**/*.{js,jsx,ts,tsx,json,md}'",
    "postinstall": "patch-package && pod-install",
    "prepare": "husky install",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:ios:release": "xcodebuild -workspace ios/MetaMask.xcworkspace -scheme MetaMask -configuration Release",
    "storybook": "start-storybook -p 7007"
  },
  "dependencies": {
    "@metamask/controllers": "^30.0.0",
    "@metamask/eth-keyring-controller": "^10.0.0",
